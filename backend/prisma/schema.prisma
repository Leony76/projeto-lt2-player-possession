// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int      @id @default(autoincrement())
  name            String   @unique

  profileImageURL String?  @map("profile_image_url")
  lumberBucks     Int      @default(0) @map("lumber_bucks")

  passwordHash    String   @map("password_hash")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  items                   UserItem[]

  sentContactRequests     Contact[]  @relation("ContactRequester")
  receivedContactRequests Contact[]  @relation("ContactAddressee")

  @@map("users")
}

model Contact {
  id Int @id @default(autoincrement())

  requesterId Int @map("requester_id")
  addresseeId Int @map("addressee_id")

  status    ContactStatus @default(PENDING)

  requester User @relation("ContactRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ContactAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([requesterId, addresseeId])

  @@index([requesterId, status])
  @@index([addresseeId, status])

  @@map("contacts")
}

model UserItem {
  id        Int      @id @default(autoincrement())

  userId    Int      @map("user_id")
  itemId    Int      @map("item_id")

  units     Int      @default(1)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, itemId])
  @@map("user_items")
}

model Item {
  id                      Int           @id @default(autoincrement())

  name                    String        @unique
  category                ItemCategory
  state                   ItemState

  originalPrice              Int?    @map("original_price")
  averageMarketPrice         Int?    @map("average_market_price")
  averageTruckloadPrice      Int?    @map("average_truckload_price")
  averageTruckloadPrice1x1   Int?    @map("average_truckload_price_1x1")

  releaseYear             Int?       @map("release_year")
  
  description             String? 

  imageURL                String     @map("image_url")

  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  users         UserItem[]           

  @@map("items")
}

enum ContactStatus {
  CONTACT
  PENDING
  NOT_CONTACT
}

enum ItemCategory {
  AXE 
  BALL
  BOOK
  CANDY
  CANDY_CANE
  FOOD
  FINE_ART
  GAME
  HOME
  PUMPKIN
  WOBBLE_BOBBLE
  VEHICLE 
  MISCELLANEOUS
  LOGIC
  CONVEYOR
  WOOD
}

enum ItemState {
  GIFT
  BOXED
  LOOSE
}